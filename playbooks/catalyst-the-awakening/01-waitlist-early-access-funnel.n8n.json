{
  "name": "Catalyst — Waitlist & Early-Access Funnel",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "catalyst-waitlist-signup",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook-signup",
      "name": "Signup Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [-720, 300],
      "webhookId": "catalyst-waitlist-signup"
    },
    {
      "parameters": {
        "jsCode": "// Normalise + validate incoming signup, generate a referral code\nconst body = $input.first().json.body || $input.first().json;\nconst email = (body.email || '').trim().toLowerCase();\nconst emailOk = /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email);\nif (!emailOk) {\n  throw new Error('INVALID_EMAIL');\n}\nconst referralCode = 'CAT-' + Buffer.from(email).toString('base64').replace(/[^A-Z0-9]/gi, '').slice(0, 8).toUpperCase();\nreturn [{ json: {\n  email,\n  name: (body.name || '').trim(),\n  referredBy: (body.ref || '').trim().toUpperCase() || null,\n  referralCode,\n  source: body.source || 'landing-page',\n  signedUpAt: new Date().toISOString()\n} }];"
      },
      "id": "node-validate",
      "name": "Validate & Make Referral Code",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-500, 300]
    },
    {
      "parameters": {
        "operation": "search",
        "base": {
          "__rl": true,
          "value": "appCatalystWaitlist",
          "mode": "id"
        },
        "table": {
          "__rl": true,
          "value": "Waitlist",
          "mode": "list"
        },
        "filterByFormula": "={{ \"{Email} = '\" + $json.email + \"'\" }}",
        "options": {}
      },
      "id": "node-dedupe-lookup",
      "name": "Check Existing Signup",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [-280, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-if-exists",
      "name": "Already On List?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-60, 300]
    },
    {
      "parameters": {
        "operation": "create",
        "base": { "__rl": true, "value": "appCatalystWaitlist", "mode": "id" },
        "table": { "__rl": true, "value": "Waitlist", "mode": "list" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Email": "={{ $('Validate & Make Referral Code').item.json.email }}",
            "Name": "={{ $('Validate & Make Referral Code').item.json.name }}",
            "Referral Code": "={{ $('Validate & Make Referral Code').item.json.referralCode }}",
            "Referred By": "={{ $('Validate & Make Referral Code').item.json.referredBy }}",
            "Referral Count": 0,
            "Status": "Waiting",
            "Source": "={{ $('Validate & Make Referral Code').item.json.source }}",
            "Signed Up At": "={{ $('Validate & Make Referral Code').item.json.signedUpAt }}"
          }
        },
        "options": {}
      },
      "id": "node-create-record",
      "name": "Add To Waitlist",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [160, 200]
    },
    {
      "parameters": {
        "fromEmail": "hello@catalyst-game.com",
        "toEmail": "={{ $('Validate & Make Referral Code').item.json.email }}",
        "subject": "You're on the list for Catalyst: The Awakening ⚡",
        "html": "<h1>Welcome, {{ $('Validate & Make Referral Code').item.json.name || 'Awakened One' }}</h1><p>You're officially on the early-access waitlist.</p><p><strong>Skip the queue:</strong> every friend who joins with your code moves you up. When you hit 3 referrals, early access unlocks automatically.</p><p>Your referral link:<br><a href=\"https://catalyst-game.com/join?ref={{ $('Validate & Make Referral Code').item.json.referralCode }}\">catalyst-game.com/join?ref={{ $('Validate & Make Referral Code').item.json.referralCode }}</a></p>",
        "options": {}
      },
      "id": "node-welcome-email",
      "name": "Send Welcome + Referral Link",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [380, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $('Validate & Make Referral Code').item.json.referredBy }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-if-referred",
      "name": "Was Referred?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [600, 200]
    },
    {
      "parameters": {
        "operation": "search",
        "base": { "__rl": true, "value": "appCatalystWaitlist", "mode": "id" },
        "table": { "__rl": true, "value": "Waitlist", "mode": "list" },
        "filterByFormula": "={{ \"{Referral Code} = '\" + $('Validate & Make Referral Code').item.json.referredBy + \"'\" }}",
        "options": {}
      },
      "id": "node-find-referrer",
      "name": "Find Referrer",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [820, 120]
    },
    {
      "parameters": {
        "operation": "update",
        "base": { "__rl": true, "value": "appCatalystWaitlist", "mode": "id" },
        "table": { "__rl": true, "value": "Waitlist", "mode": "list" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{ $json.id }}",
            "Referral Count": "={{ ($json.fields['Referral Count'] || 0) + 1 }}",
            "Status": "={{ (($json.fields['Referral Count'] || 0) + 1) >= 3 ? 'Early Access Unlocked' : 'Waiting' }}"
          }
        },
        "options": {}
      },
      "id": "node-bump-referrer",
      "name": "Credit Referrer + Unlock Check",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [1040, 120]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.fields['Status'] }}",
              "rightValue": "Early Access Unlocked",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-if-unlocked",
      "name": "Just Unlocked?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1260, 120]
    },
    {
      "parameters": {
        "fromEmail": "hello@catalyst-game.com",
        "toEmail": "={{ $json.fields['Email'] }}",
        "subject": "Early access unlocked ⚡ Welcome to Catalyst",
        "html": "<h1>Your access is live</h1><p>You hit 3 referrals — early access to Catalyst: The Awakening is now unlocked. Your download key and Discord invite are inside.</p><p><a href=\"https://catalyst-game.com/access/{{ $json.fields['Referral Code'] }}\">Claim your access →</a></p>",
        "options": {}
      },
      "id": "node-unlock-email",
      "name": "Send Access Unlocked Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1480, 40]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"ok\", \"referralCode\": $('Validate & Make Referral Code').item.json.referralCode } }}",
        "options": {}
      },
      "id": "node-respond-ok",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [820, 340]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": 200,
        "responseBody": "={{ { \"status\": \"already_registered\" } }}",
        "options": {}
      },
      "id": "node-respond-dupe",
      "name": "Respond Already Registered",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [160, 420]
    }
  ],
  "connections": {
    "Signup Webhook": { "main": [[{ "node": "Validate & Make Referral Code", "type": "main", "index": 0 }]] },
    "Validate & Make Referral Code": { "main": [[{ "node": "Check Existing Signup", "type": "main", "index": 0 }]] },
    "Check Existing Signup": { "main": [[{ "node": "Already On List?", "type": "main", "index": 0 }]] },
    "Already On List?": { "main": [[{ "node": "Respond Already Registered", "type": "main", "index": 0 }], [{ "node": "Add To Waitlist", "type": "main", "index": 0 }]] },
    "Add To Waitlist": { "main": [[{ "node": "Send Welcome + Referral Link", "type": "main", "index": 0 }]] },
    "Send Welcome + Referral Link": { "main": [[{ "node": "Was Referred?", "type": "main", "index": 0 }]] },
    "Was Referred?": { "main": [[{ "node": "Find Referrer", "type": "main", "index": 0 }], [{ "node": "Respond OK", "type": "main", "index": 0 }]] },
    "Find Referrer": { "main": [[{ "node": "Credit Referrer + Unlock Check", "type": "main", "index": 0 }]] },
    "Credit Referrer + Unlock Check": { "main": [[{ "node": "Just Unlocked?", "type": "main", "index": 0 }]] },
    "Just Unlocked?": { "main": [[{ "node": "Send Access Unlocked Email", "type": "main", "index": 0 }], []] },
    "Send Access Unlocked Email": { "main": [[{ "node": "Respond OK", "type": "main", "index": 0 }]] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": { "templateId": "catalyst-01-waitlist" }
}
