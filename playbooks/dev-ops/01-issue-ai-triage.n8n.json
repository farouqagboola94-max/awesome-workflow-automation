    { "parameters": { "modelId": { "__rl": true, "value": "gpt-4o-mini", "mode": "list" }, "messages": { "values": [ { "content": "You triage GitHub issues for an awesome-list / open-source repo. Return strict JSON: {\"type\":\"bug|enhancement|question|submission|spam\",\"priority\":\"low|medium|high\",\"labels\":[\"..\"],\"needsInfo\":true|false,\"reply\":\"one short maintainer-style comment\"}. type=submission means a request to add a tool to the list.", "role": "system" }, { "content": "=Title: {{ $json.body.issue.title }}\n\nBody: {{ $json.body.issue.body }}" } ] }, "jsonOutput": true, "options": { "temperature": 0 } }, "id": "n2", "name": "AI Triage", "type": "@n8n/n8n-nodes-langchain.openAi", "typeVersion": 1.8, "position": [-600, 300] },
