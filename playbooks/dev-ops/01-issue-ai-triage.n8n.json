    { "parameters": { "conditions": { "options": { "caseSensitive": true, "typeValidation": "strict" }, "conditions": [ { "leftValue": "={{ $('AI Triage').item.json.message.content.type }}", "rightValue": "spam", "operator": { "type": "string", "operation": "equals" } } ], "combinator": "and" }, "options": {} }, "id": "n5", "name": "Is Spam?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [-380, 420] },
