{
  "name": "Dev-Ops — Awesome List Dead-Link Checker",
  "nodes": [
    { "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 5 * * 1" }] } }, "id": "n1", "name": "Weekly Mon 05:00", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [-860, 300] },
    { "parameters": { "url": "=https://raw.githubusercontent.com/{{ $env.GH_REPO }}/main/readme.md", "options": {} }, "id": "n2", "name": "Fetch readme.md", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [-640, 300] },
    { "parameters": { "jsCode": "// Extract all markdown links\nconst md = $input.first().json.data || $input.first().json.body || '';\nconst re = /\\[[^\\]]+\\]\\((https?:\\/\\/[^)\\s]+)\\)/g;\nconst seen = new Set();\nconst out = [];\nlet m;\nwhile ((m = re.exec(md)) !== null) { const u = m[1]; if (!seen.has(u)) { seen.add(u); out.push({ json: { url: u } }); } }\nreturn out;" }, "id": "n3", "name": "Extract Links", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-440, 300] },
    { "parameters": { "method": "HEAD", "url": "={{ $json.url }}", "options": { "response": { "response": { "neverError": true, "fullResponse": true } }, "timeout": 10000, "redirect": { "redirect": {} } } }, "id": "n4", "name": "Check Each URL", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [-240, 300] },
    { "parameters": { "conditions": { "options": { "caseSensitive": true, "typeValidation": "loose" }, "conditions": [ { "leftValue": "={{ $json.statusCode }}", "rightValue": 400, "operator": { "type": "number", "operation": "gte" } } ], "combinator": "and" }, "options": {} }, "id": "n5", "name": "Broken?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [-40, 300] },
    { "parameters": { "aggregate": "aggregateAllItemData", "options": {} }, "id": "n6", "name": "Collect Dead Links", "type": "n8n-nodes-base.aggregate", "typeVersion": 1, "position": [180, 220] },
    { "parameters": { "resource": "issue", "operation": "create", "owner": "={{ $env.GH_OWNER }}", "repository": "={{ $env.GH_REPO_NAME }}", "title": "=🔗 Dead-link report ({{ $now.toFormat('yyyy-MM-dd') }})", "body": "=Automated weekly link check found broken links:\n\n{{ $json.data.map(d => '- ' + d.url + ' → HTTP ' + d.statusCode).join('\\n') }}" }, "id": "n7", "name": "Open Report Issue", "type": "n8n-nodes-base.github", "typeVersion": 1, "position": [400, 220] }
  ],
  "connections": {
    "Weekly Mon 05:00": { "main": [[{ "node": "Fetch readme.md", "type": "main", "index": 0 }]] },
    "Fetch readme.md": { "main": [[{ "node": "Extract Links", "type": "main", "index": 0 }]] },
    "Extract Links": { "main": [[{ "node": "Check Each URL", "type": "main", "index": 0 }]] },
    "Check Each URL": { "main": [[{ "node": "Broken?", "type": "main", "index": 0 }]] },
    "Broken?": { "main": [[{ "node": "Collect Dead Links", "type": "main", "index": 0 }], []] },
    "Collect Dead Links": { "main": [[{ "node": "Open Report Issue", "type": "main", "index": 0 }]] }
  },
  "active": false, "settings": { "executionOrder": "v1" }, "pinData": {}, "meta": { "templateId": "devops-05-link-checker" }
}
