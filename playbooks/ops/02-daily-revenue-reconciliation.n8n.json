{
  "name": "Ops — Daily Revenue Reconciliation",
  "nodes": [
    { "parameters": { "rule": { "interval": [{ "field": "cronExpression", "expression": "0 7 * * *" }] } }, "id": "n1", "name": "Daily 07:00", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.2, "position": [-820, 300] },
    { "parameters": { "operation": "search", "base": { "__rl": true, "value": "appShared", "mode": "id" }, "table": { "__rl": true, "value": "Orders", "mode": "list" }, "filterByFormula": "={{ \"IS_AFTER({Created}, DATEADD(NOW(),-1,'days'))\" }}", "options": {} }, "id": "n2", "name": "Yesterday's Orders", "type": "n8n-nodes-base.airtable", "typeVersion": 2.1, "position": [-600, 300] },
    { "parameters": { "jsCode": "const o=$input.all();const total=o.reduce((s,r)=>s+Number(r.json.fields?.Amount||0),0);const byTier=o.reduce((a,r)=>{const t=r.json.fields?.Tier||'other';a[t]=(a[t]||0)+Number(r.json.fields?.Amount||0);return a;},{});return [{json:{count:o.length,total,byTier}}];" }, "id": "n3", "name": "Aggregate", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [-380, 300] },
    { "parameters": { "fromEmail": "finance@example.com", "toEmail": "={{ $env.FINANCE_EMAILS }}", "subject": "=Daily revenue — {{ $now.toFormat('yyyy-MM-dd') }}", "html": "=<p>Orders: {{ $json.count }} · Total: <strong>{{ $json.total }}</strong></p><pre>{{ JSON.stringify($json.byTier, null, 2) }}</pre>", "options": {} }, "id": "n4", "name": "Email Summary", "type": "n8n-nodes-base.emailSend", "typeVersion": 2.1, "position": [-160, 300] }
  ],
  "connections": {
    "Daily 07:00": { "main": [[{ "node": "Yesterday's Orders", "type": "main", "index": 0 }]] },
    "Yesterday's Orders": { "main": [[{ "node": "Aggregate", "type": "main", "index": 0 }]] },
    "Aggregate": { "main": [[{ "node": "Email Summary", "type": "main", "index": 0 }]] }
  },
  "active": false, "settings": { "executionOrder": "v1" }, "pinData": {}, "meta": { "templateId": "ops-02-revenue" }
}
